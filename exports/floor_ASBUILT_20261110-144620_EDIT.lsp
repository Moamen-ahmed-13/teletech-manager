(if *tt-e* (vla-Move (vlax-ename->vla-object *tt-e*) (vlax-3d-point (list 32208 -41698.0797803 0.0)) (vlax-3d-point (list 33208 -41069.8275605 0.0))) (princ "\nWARNING: target handle not found.\n"))
(princ "\nTELETECH As-Built change 2: DELETE_ENDPOINT\n")
(setq *tt-cloned* (tt:clone-path (quote ("access point wifi weather proof")) (quote ("721BB")) "8081F37" T))
(if *tt-cloned* (princ "\nNested endpoint removed from a private block-instance clone.\n") (princ "\nWARNING: nested clone/delete unsupported for this block; original instance left unchanged.\n"))
(princ "\nTELETECH As-Built change 3: DELETE_ENDPOINT\n")
(setq *tt-cloned* (tt:clone-path (quote ("access point wifi weather proof")) (quote ("721B6")) "8081F37" T))
